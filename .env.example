# ── PromptNexus ────────────────────────────────────────────────────────────────
# Copy to .env.local for development. On Vercel, set these in Project Settings.
# Every variable is optional: with none of them set, the app runs in No-AI mode
# on the deterministic engine and produces identical prompt structure.
# ──────────────────────────────────────────────────────────────────────────────

# Node runtime for local development
NODE_ENV=development

# Port for the local preview server (default 4317)
PORT=4317

# ── Optional: AI provider refinement ───────────────────────────────────────────
# When configured, wording may be softened by a model AFTER the deterministic
# engine has classified, scored and red-teamed the prompt. Provider output can
# never change classification, scoring, safeguards or assumptions.
# Keys are read server-side only and are never sent to the browser.

# PROVIDER=openai            # openai | anthropic | google | xai | deepseek | openai-compatible | none
# PROVIDER_API_KEY=
# PROVIDER_MODEL=            # leave blank for the provider default
# PROVIDER_BASE_URL=         # required only for PROVIDER=openai-compatible (e.g. local Ollama)

# Hard ceiling on provider calls per day. Reaching it disables refinement only;
# the engine keeps working.
# PROVIDER_DAILY_CALL_LIMIT=200

# Per-request timeout in milliseconds for provider calls (fail fast, fall back).
# PROVIDER_TIMEOUT_MS=12000
