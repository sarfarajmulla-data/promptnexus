#!/usr/bin/env sh
#
# Pre-commit checks. Install with: npm run hooks
#
# Fast enough to run on every commit (well under a second): a secret scan of the
# staged diff, a syntax check of staged JavaScript, and a guard against committing
# build output or environment files. The full test suite is deliberately NOT run
# here — CI does that, and a slow hook is a disabled hook.

set -e

RED='\033[0;31m'; GREEN='\033[0;32m'; DIM='\033[2m'; NC='\033[0m'

staged=$(git diff --cached --name-only --diff-filter=ACMR)

# ── 1. Never commit these ──────────────────────────────────────────────────────
for f in $staged; do
  case "$f" in
    .env|.env.local|.env.*.local)
      printf "${RED}✖ Refusing to commit %s${NC}\n" "$f"
      printf "  Environment files belong in the deployment settings, not in git.\n"
      exit 1 ;;
    public/engine/*)
      printf "${RED}✖ Refusing to commit %s${NC}\n" "$f"
      printf "  public/engine/ is generated by 'npm run build' and is gitignored.\n"
      exit 1 ;;
  esac
done

# ── 2. Secret scan of staged content ──────────────────────────────────────────
if [ -n "$staged" ]; then
  node scripts/scan-secrets.mjs --staged || exit 1
fi

# ── 3. Syntax-check staged JavaScript ─────────────────────────────────────────
js=$(echo "$staged" | grep -E '\.(mjs|js|cjs)$' || true)
if [ -n "$js" ]; then
  for f in $js; do
    [ -f "$f" ] || continue
    if ! node --check "$f" 2>/dev/null; then
      printf "${RED}✖ Syntax error in %s${NC}\n" "$f"
      node --check "$f"
      exit 1
    fi
  done
  printf "${GREEN}✓${NC} syntax ok ${DIM}(%s checked)${NC}\n" "$(echo "$js" | wc -l | tr -d ' ')"
fi

# ── 4. Warn (do not block) on a large commit ──────────────────────────────────
count=$(echo "$staged" | grep -c . || true)
if [ "$count" -gt 25 ]; then
  printf "${DIM}note: %s files staged — consider splitting into smaller commits${NC}\n" "$count"
fi

exit 0
